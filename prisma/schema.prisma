// RevenueRecover AI Multi-Tenant PostgreSQL Schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
  VIEWER
}

enum PlanTier {
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

enum PlanStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum OpportunityType {
  MISSED_LEAD
  MISSED_CALL
  UNCONTACTED_LEAD
  UNRESPONSIVE_LEAD
  ABANDONED_QUOTE
  REJECTED_QUOTE
  FAILED_PAYMENT
  OVERDUE_INVOICE
  CANCELLED_APPOINTMENT
  NO_SHOW
  DORMANT_CUSTOMER
  LOST_CUSTOMER
  UPSELL
  CROSS_SELL
  REPEAT_PURCHASE
  HIGH_VALUE_RISK
}

enum OpportunityStatus {
  DETECTED
  IN_PROGRESS
  AWAITING_APPROVAL
  CONTACTED
  RECOVERED
  DISMISSED
}

enum Channel {
  SMS
  EMAIL
  WEBCHAT
  CALL
}

model Organization {
  id                String         @id @default(cuid())
  name              String
  industry          String
  ownerEmail        String
  plan              PlanTier       @default(GROWTH)
  planStatus        PlanStatus     @default(ACTIVE)
  monthlyRecovered  Float          @default(0)
  lifetimeRecovered Float          @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  members           OrganizationMember[]
  customers         Customer[]
  opportunities     Opportunity[]
  campaigns         Campaign[]
  integrations      Integration[]
  referrals         Referral[]
  auditLogs         AuditLog[]
  events            SystemEvent[]
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  name           String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  memberships    OrganizationMember[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole     @default(AGENT)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Customer {
  id                 String         @id @default(cuid())
  organizationId     String
  name               String
  email              String
  phone              String
  address            String?
  lifetimeValue      Float          @default(0)
  totalPurchases     Int            @default(0)
  lastPurchaseDate   DateTime?
  lastContactDate    DateTime?
  status             String         @default("active")
  tags               String[]
  aiSummary          String?
  nextAction         String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunities      Opportunity[]
  conversations      Conversation[]
}

model Opportunity {
  id                 String            @id @default(cuid())
  organizationId     String
  customerId         String
  type               OpportunityType
  estimatedValue     Float
  confidenceScore    Int               @default(80)
  recoveryScore      Int               @default(80)
  urgency            String            @default("medium")
  recommendedAction  String
  recommendedChannel Channel           @default(SMS)
  status             OpportunityStatus @default(DETECTED)
  source             String
  scoreReasons       String[]
  recoveredAmount    Float?
  recoveredAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Campaign {
  id                 String         @id @default(cuid())
  organizationId     String
  name               String
  type               String
  status             String         @default("active")
  stats              Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Conversation {
  id                 String         @id @default(cuid())
  customerId         String
  channel            Channel        @default(SMS)
  status             String         @default("ai_handling")
  aiClassification   String?
  aiSuggestedReply   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  customer           Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages           ChatMessage[]
}

model ChatMessage {
  id                 String         @id @default(cuid())
  conversationId     String
  sender             String
  text               String
  channel            Channel        @default(SMS)
  status             String         @default("delivered")
  timestamp          DateTime       @default(now())

  conversation       Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Integration {
  id                 String         @id @default(cuid())
  organizationId     String
  provider           String
  name               String
  category           String
  status             String         @default("connected")
  mode               String         @default("demo")
  lastSyncAt         DateTime?
  syncCount          Int            @default(0)
  createdAt          DateTime       @default(now())

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Referral {
  id                 String         @id @default(cuid())
  organizationId     String
  referralCode       String
  referredBusiness   String
  referredEmail      String
  status             String         @default("invited")
  reward             String
  createdAt          DateTime       @default(now())

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id                 String         @id @default(cuid())
  organizationId     String
  channel            Channel
  recipient          String
  consentBasis       String
  messageSnippet     String
  status             String
  agent              String
  timestamp          DateTime       @default(now())

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SystemEvent {
  id                 String         @id @default(cuid())
  organizationId     String
  eventType          String
  actorAgent         String?
  payload            Json
  timestamp          DateTime       @default(now())

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ==============================================================================
// GLOBAL CONTRACTOR DISCOVERY & LEAD INTELLIGENCE ENGINE MODELS
// ==============================================================================

model SourceRegistry {
  id                         String   @id
  sourceName                 String
  sourceType                 String
  country                    String
  categories                 String[]
  officialApiAvailable       Boolean  @default(true)
  apiDocumentationUrl        String?
  authenticationType         String   @default("API_KEY")
  rateLimitPerMinute         Int      @default(300)
  termsUrl                   String?
  robotsPolicy               String   @default("ALLOWED")
  dataFieldsAvailable        String[]
  leadCaptureSupported       Boolean  @default(false)
  businessDiscoverySupported Boolean  @default(true)
  integrationStatus          String   @default("CONNECTED")
  enabled                    Boolean  @default(true)
  lastChecked                DateTime @default(now())
  complianceNotes            String?
  estimatedCostPerCallUSD    Float    @default(0.0)

  sourceRecords              BusinessSourceRecord[]
}

model BusinessMaster {
  id                   String   @id @default(cuid())
  tenantId             String   @default("org_default")
  businessName         String
  normalizedName       String
  primaryTrade         String   @default("HVAC")
  secondaryTrades      String[]
  phoneE164            String?
  email                String?
  website              String?
  domain               String?
  addressLine1         String
  city                 String
  stateProvince        String
  postalCode           String
  country              String   @default("USA")
  geoLatitude          Float?
  geoLongitude         Float?
  serviceRadiusMiles   Int      @default(25)
  verificationScore    Int      @default(50)
  verificationStatus   String   @default("MEDIUM")
  verificationReasons  String[]
  averageRating        Float    @default(4.5)
  totalReviews         Int      @default(0)
  sourceCount          Int      @default(1)
  connectedSourceIds   String[]
  dataQualityScore     Int      @default(80)
  isActive             Boolean  @default(true)
  isAcceptingLeads     Boolean  @default(true)
  monthlyCapacity      Int      @default(50)
  currentActiveLeads   Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  sourceRecords        BusinessSourceRecord[]
  leadsAssigned        Lead[]
  matchedOpportunities MasterOpportunity[]

  @@index([tenantId, primaryTrade, city, country])
  @@index([normalizedName, phoneE164, domain])
}

model BusinessSourceRecord {
  id               String         @id @default(cuid())
  businessMasterId String
  sourceId         String
  sourceRecordId   String
  sourceUrl        String?
  rawPayload       Json?
  discoveredAt     DateTime       @default(now())

  business         BusinessMaster @relation(fields: [businessMasterId], references: [id], onDelete: Cascade)
  sourceRegistry   SourceRegistry @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, sourceRecordId])
}

model Lead {
  id                          String            @id @default(cuid())
  tenantId                    String            @default("org_default")
  assignedBusinessId          String?
  masterOpportunityId         String?
  sourceType                  String            @default("SEARCH_MAPS")
  sourceChannel               String            @default("MISSED_PHONE_CALL")
  customerName                String?
  customerPhoneE164           String?
  customerEmail               String?
  serviceCategory             String            @default("HVAC")
  serviceRequested            String
  issueDescription            String?
  city                        String
  stateProvince               String
  postalCode                  String
  country                     String            @default("USA")
  geoLatitude                 Float?
  geoLongitude                Float?
  urgency                     String            @default("HIGH")
  estimatedJobValueUSD        Float             @default(450)
  leadScore                   Int               @default(75)
  leadClassification          String            @default("HOT")
  scoreReasons                String[]
  aiClassificationExplanation String?
  consentStatus               String            @default("IMPLIED_INQUIRY")
  consentTimestamp            DateTime          @default(now())
  isDuplicate                 Boolean           @default(false)
  status                      String            @default("NEW")
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  assignedBusiness            BusinessMaster?   @relation(fields: [assignedBusinessId], references: [id])
  masterOpportunity           MasterOpportunity? @relation(fields: [masterOpportunityId], references: [id])
  events                      LeadSourceEvent[]

  @@index([tenantId, serviceCategory, city, status])
}

model MasterOpportunity {
  id                        String          @id @default(cuid())
  tenantId                  String          @default("org_default")
  primaryLeadId             String
  customerIdentifier        String
  customerName              String?
  customerPhone             String?
  customerEmail             String?
  tradeCategory             String          @default("HVAC")
  summary                   String
  highestUrgency            String          @default("HIGH")
  estimatedPipelineValueUSD Float           @default(650)
  compositeScore            Int             @default(80)
  classification            String          @default("HOT")
  assignedBusinessId        String?
  stage                     String          @default("INBOX")
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  assignedBusiness          BusinessMaster? @relation(fields: [assignedBusinessId], references: [id])
  leads                     Lead[]
  events                    LeadSourceEvent[]

  @@index([tenantId, customerIdentifier, stage])
}

model LeadSourceEvent {
  id                  String             @id @default(cuid())
  leadId              String
  masterOpportunityId String?
  sourceType          String
  channel             String
  rawPayload          Json?
  timestamp           DateTime           @default(now())

  lead                Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  masterOpportunity   MasterOpportunity? @relation(fields: [masterOpportunityId], references: [id])
}

model DiscoveryJobRun {
  id                     String   @id @default(cuid())
  tenantId               String   @default("org_default")
  country                String
  city                   String
  category               String
  sourcesQueried         String[]
  totalRawDiscovered     Int      @default(0)
  totalUniqueEntities    Int      @default(0)
  duplicatesConsolidated Int      @default(0)
  verifiedCount          Int      @default(0)
  estimatedCostUSD       Float    @default(0.0)
  startedAt              DateTime @default(now())
  completedAt            DateTime @default(now())
}

