# Supabase Auth / Data API — use the staging project for Preview deployments.
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_staging_service_role_key

# -----------------------------------------------------------------------------
# V2 LEAD ENGINE — SERVER ONLY
# -----------------------------------------------------------------------------
# Google Places API (Places API New / Text Search)
GOOGLE_PLACES_API_KEY=replace_with_server_only_google_places_key
# Optional Yelp Fusion enrichment key. Qualified leads still require an owned domain + MX verification.
YELP_FUSION_API_KEY=replace_with_server_only_yelp_fusion_key

# -----------------------------------------------------------------------------
# PRIMARY PAYMENT GATEWAY: RAZORPAY RECURRING SUBSCRIPTIONS
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_replace_me
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
RAZORPAY_PLAN_ID_STARTER=plan_replace_with_usd_499_monthly_plan
RAZORPAY_PLAN_ID_GROWTH=plan_replace_with_usd_999_monthly_plan
RAZORPAY_PLAN_ID_REVENUE_PARTNER=plan_replace_with_usd_1299_monthly_plan
RAZORPAY_LIVE_PAYMENTS_ENABLED=false

# -----------------------------------------------------------------------------
# SECONDARY PAYMENT GATEWAY: PAYPAL RECURRING SUBSCRIPTIONS
# -----------------------------------------------------------------------------
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_sandbox_client_secret
PAYPAL_WEBHOOK_ID=replace_with_the_webhook_id_for_this_environment
PAYPAL_PLAN_ID_STARTER=P-replace_with_legacy_starter_plan_if_applicable
PAYPAL_PLAN_ID_GROWTH=P-replace_with_active_usd_999_monthly_plan
PAYPAL_PLAN_ID_REVENUE_PARTNER=P-replace_with_active_usd_1299_monthly_plan

# -----------------------------------------------------------------------------
# APPLICATION URLS
# -----------------------------------------------------------------------------
# Preview deployments use Vercel's VERCEL_URL. Production should use a stable HTTPS origin.
# APP_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://your-stable-app-domain.example
