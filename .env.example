# Public Supabase settings for the RevenueRecover AI staging project.
# The URL and publishable key are safe to expose to the browser. Replace the placeholder key.
NEXT_PUBLIC_SUPABASE_URL=https://jzoighxrxgbtqrdhknpb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_staging_key

# Server-only secrets. Do not prefix these with NEXT_PUBLIC_ and do not commit real values.
# Required by the scheduled growth endpoint; use a long random value in the deployment settings.
CRON_SECRET=

# Webhook secrets are configured in each payment provider dashboard.
# Webhook events currently provide signature checks only and are NOT a subscription activation system.
STRIPE_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Future payment integration values. Checkout endpoints intentionally return 503 until configured
# with reconciled pricing, a verified sandbox and persistent order/subscription handling.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
