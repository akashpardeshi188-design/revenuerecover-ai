# Supabase Auth / Data API — use the staging project for Preview deployments.
# Obtain these from Supabase Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Do not put SUPABASE_SERVICE_ROLE_KEY in NEXT_PUBLIC_* variables or browser code.

# PayPal recurring subscriptions — configure sandbox credentials for Preview first.
# Do NOT expose PAYPAL_CLIENT_SECRET, SUPABASE_SERVICE_ROLE_KEY, or webhook secrets in NEXT_PUBLIC_* variables.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_sandbox_client_secret
PAYPAL_PLAN_ID_STARTER=replace_with_active_usd_monthly_plan_id
PAYPAL_PLAN_ID_GROWTH=replace_with_active_usd_monthly_plan_id
PAYPAL_PLAN_ID_REVENUE_PARTNER=replace_with_active_usd_monthly_plan_id
PAYPAL_WEBHOOK_ID=replace_with_the_webhook_id_for_this_environment
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_staging_service_role_key
# Preview deployments always use Vercel's current VERCEL_URL. Leave APP_BASE_URL unset in Preview.
# Local development: APP_BASE_URL=http://localhost:3000
# Production cutover only: set APP_BASE_URL to the stable HTTPS app origin.
# NEXT_PUBLIC_SITE_URL=https://your-stable-app-domain.example
